{
  "name": "traceqa",
  "version": "0.1.0",
  "description": "Intelligent CLI tool for developer-driven QA testing",
  "main": "dist/index.js",
  "bin": {
    "traceqa": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "test": "npm run typecheck",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "demo": "tsx src/demo/demo-runner.ts",
    "demo:mock": "tsx src/demo/demo-runner.ts --mock",
    "smoke:ibm": "tsx src/smoke-tests/ibm-smoke-test.ts"
  },
  "keywords": [
    "qa",
    "testing",
    "cli",
    "ai",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@ibm-cloud/watsonx-ai": "^1.1.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "ibm-cloud-sdk-core": "^4.3.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
